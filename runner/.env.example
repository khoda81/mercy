# Copy this file to runner/.env (gitignored) or export these variables in your shell.
# Get RUNNER_TOKEN from:
#   GitHub repo -> Settings -> Actions -> Runners -> New self-hosted runner
RUNNER_TOKEN=

RUNNER_NAME=mercy-4600h

# One logical CPU for stable single-thread measurements.
# Inspect topology with: lscpu -e=CPU,CORE,SOCKET,NODE
BENCH_CPU=4

BENCH_MEMORY=4g
